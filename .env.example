# Copy this file to .env and adjust. All variables are optional.

# Port the server listens on
PORT=8080

# Where runtime data (SQLite database) is stored
DATA_DIR=./data

# Initial admin account. If ADMIN_PASSWORD is unset, a random password
# is generated and printed to the console on first run.
ADMIN_USER=admin
# ADMIN_PASSWORD=

# Public base URL used in notification messages
PUBLIC_URL=http://localhost:8080

# How often the checker wakes up (ms). Only polls due monitors.
# CHECKER_TICK_MS=2000